### Keep only source, build configuration and required test seeds ###
/*
!/src/
!/.gitignore
!/.gitattributes
!/pom.xml
!/mvnw
!/mvnw.cmd
!/.dockerignore
!/deploy/
!/.github/

!/.mvn/
/.mvn/*
!/.mvn/wrapper/
/.mvn/wrapper/*
!/.mvn/wrapper/maven-wrapper.properties

!/scripts/
/scripts/*
!/scripts/main_script.txt
!/scripts/novos_candidatos_51_75.txt

