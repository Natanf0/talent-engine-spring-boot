# Copy to /opt/talentengine/secrets/spring.env with mode 0600, then fill in.
# Compose reads this as raw: use literal values WITHOUT surrounding quotes.
AURA_URI=neo4j+s://CHANGE_ME
AURA_USER=CHANGE_ME
AURA_PASSWORD=CHANGE_ME

EMAIL_ME=CHANGE_ME
EMAIL_APP_PASSWORD=CHANGE_ME

R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
R2_BUCKET=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME

# Optional assisted filling. Keep disabled until a funded API key is configured.
AI_EXTRACTION_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_EXTRACTION_MAX_PDF_BYTES=5242880
AI_EXTRACTION_MAX_PAGES=20
AI_EXTRACTION_MAX_TEXT_CHARACTERS=60000
AI_EXTRACTION_MAX_CONCURRENT=2
DEEPSEEK_CONNECT_TIMEOUT=5s
DEEPSEEK_READ_TIMEOUT=60s
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
